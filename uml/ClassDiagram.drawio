<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="xJe5HL-tUzzX3A5tEd4K">
    <mxGraphModel dx="2512" dy="1285" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% ==================== HELPER PACKAGE ====================\n    class Capability {\n        &lt;&lt;enumeration&gt;&gt;\n        SCIENTIFIC_RESEARCH\n        EQUIPMENT_REPAIR\n        MEDICAL_CARE\n        SURFACE_EXPLORATION\n        AERIAL_RECON\n        COMMUNICATION\n        FIRE_RESPONSE\n        RESCUE\n    }\n\n    class EmergencyState {\n        &lt;&lt;enumeration&gt;&gt;\n        TRIGGERED\n        RESOLVED\n        UNRESOLVED\n    }\n\n    class EnvironmentCondition {\n        &lt;&lt;enumeration&gt;&gt;\n        NORMAL\n        DUST_STORM\n        COMMUNICATION_DISRUPTION\n    }\n\n    class MissionState {\n        &lt;&lt;enumeration&gt;&gt;\n        ASSIGNED\n        IN_PROGRESS\n        COMPLETED\n        FAILED\n    }\n\n    class ResourceType {\n        &lt;&lt;enumeration&gt;&gt;\n        OXYGEN\n        WATER\n        FOOD\n        FUEL\n        BATTERY_POWER\n        MEDICAL_SUPPLIES\n        SPARE_PARTS\n    }\n\n    class Equipment {\n        -String name\n        -Capability providedCapability\n        -boolean damaged\n        -int usageNumber\n        -boolean available\n        +Equipment(String, Capability)\n        +createSpectrometer()$ Equipment\n        +createMicroscope()$ Equipment\n        +createRepairToolkit()$ Equipment\n        +createWeldingTorch()$ Equipment\n        +createMedicalScanner()$ Equipment\n        +createSurgicalKit()$ Equipment\n        +createAntennaArray()$ Equipment\n        +createDroneControlTerminal()$ Equipment\n        +createFireExtinguisher()$ Equipment\n        +useIt() boolean\n        +fixIt() void\n        +isAvailable() boolean\n        +isDamaged() boolean\n    }\n\n    %% ==================== ENVIRONMENT PACKAGE ====================\n    class Environment {\n        -EnvironmentCondition environmentCondition$\n        +Environment()\n        +setCondition(EnvironmentCondition) void\n        +setState(EnvironmentCondition)$ void\n        +changeState() void\n        +getState()$ EnvironmentCondition\n    }\n\n    %% ==================== AGENT PACKAGE ====================\n    class Agent {\n        &lt;&lt;abstract&gt;&gt;\n        -String name\n        -String id\n        #int healthStatus\n        #boolean availability\n        -boolean onMission\n        -String location\n        #Set~Capability~ capabilities\n        +Agent(String, String, String)\n        #updateAvailability()* void\n        +takeDamage(int) boolean\n        +restoreHealth(int) boolean\n        +isHuman()* boolean\n        +isRobot()* boolean\n        +canPerform(Mission) boolean\n        +canHandle(Capability) boolean\n    }\n\n    class CrewMember {\n        &lt;&lt;abstract&gt;&gt;\n        -int fatigueLevel\n        +CrewMember(String, String, String)\n        +increaseFatigue(int) boolean\n        +rest(int) boolean\n        +eat(Habitat, int) boolean\n        +drink(Habitat, int) boolean\n        #updateAvailability() void\n        +isHuman() boolean\n        +isRobot() boolean\n    }\n\n    class RoboticUnit {\n        &lt;&lt;abstract&gt;&gt;\n        -int batteryLevel\n        +RoboticUnit(String, String, String)\n        +discharge(int) boolean\n        +charge(PowerStation, int) boolean\n        #updateAvailability() void\n        +isHuman() boolean\n        +isRobot() boolean\n    }\n\n    class Vehicle {\n        &lt;&lt;abstract&gt;&gt;\n        +Vehicle(String, String, String)\n    }\n\n    class Engineer {\n        -int nextId$\n        +Engineer()\n        +Engineer(String, String)\n    }\n\n    class MedicalOfficer {\n        -int nextId$\n        +MedicalOfficer()\n        +MedicalOfficer(String, String)\n    }\n\n    class Scientist {\n        -int nextId$\n        +Scientist()\n        +Scientist(String, String)\n    }\n\n    class RepairRobot {\n        -int nextId$\n        +RepairRobot()\n        +RepairRobot(String, String)\n    }\n\n    class ExplorationRover {\n        -int nextId$\n        -List~Equipment~ carriedEquipment\n        +ExplorationRover()\n        +ExplorationRover(String, String)\n        +loadEquipment(Equipment) boolean\n        +unloadEquipment(Equipment) boolean\n        +getCarriedEquipment() List~Equipment~\n    }\n\n    class Drone {\n        -int nextId$\n        +Drone()\n        +Drone(String, String)\n    }\n\n    %% ==================== FACILITY PACKAGE ====================\n    class Facility {\n        &lt;&lt;abstract&gt;&gt;\n        -String location\n        -int currentOccupancy\n        -int capacity\n        -boolean isOperational\n        -List~Equipment~ equipments\n        #Map~ResourceType, Integer~ resources\n        #int maxResources\n        #int POWER_COST$\n        +Facility(String, int, int, int, Equipment[])\n        +addOccupiers() boolean\n        +removeOccupiers() boolean\n        +addResource(ResourceType, int) boolean\n        +deductResource(ResourceType, int) int\n        +transferResourceTo(Facility, ResourceType, int) boolean\n        +useResources()* boolean\n    }\n\n    class LifeSupportSystem {\n        -int filtrationRate\n        -boolean isFunctional\n        +LifeSupportSystem(int)\n        +getFiltrationRate() int\n        +isFunctional() boolean\n        +setFunctional(boolean) void\n    }\n\n    class Habitat {\n        -LifeSupportSystem lifeSupport\n        +Habitat()\n        +useResources() boolean\n        +getLifeSupport() LifeSupportSystem\n    }\n\n    class Laboratory {\n        -boolean hasFire\n        +Laboratory()\n        +useResources() boolean\n        +hasFire() boolean\n        +setHasFire(boolean) void\n    }\n\n    class PowerStation {\n        -int chargingRate\n        +PowerStation()\n        +generatePower() boolean\n        +useResources() boolean\n    }\n\n    class StorageFacilities {\n        +StorageFacilities()\n        +useResources() boolean\n    }\n\n    class CommunicationStation {\n        +CommunicationStation()\n        +changeOperationalStatus(Environment) void\n        +useResources() boolean\n    }\n\n    %% ==================== MISSION PACKAGE ====================\n    class Mission {\n        &lt;&lt;abstract&gt;&gt;\n        #Colony colony\n        #String missionId\n        -String description\n        -MissionState status\n        -String location\n        #ResourceType[] resources\n        #int requiredDuration\n        #int timeElapsed\n        #String failureReason\n        #Equipment equipment\n        #List~Agent~ assignedAgents\n        +Mission(Colony, String, String, ResourceType[], Equipment, int)\n        +submitMission()* boolean\n        +startMission() boolean\n        +progress(int) void\n        +isCompleted() boolean\n        +fail(String) void\n        +complete() void\n        #endMission(MissionState) void\n    }\n\n    class ExplorationMission {\n        -Agent crewMember\n        -Vehicle vehicle\n        -double requiredBatteryLevel\n        +ExplorationMission(...)\n        +submitMission() boolean\n        +startMission() boolean\n        +endMission(MissionState) void\n    }\n\n    class RepairMission {\n        -Agent engineer\n        -Agent repairRobot\n        -Facility targetFacility\n        -Equipment targetEquipment\n        +RepairMission(...)\n        +submitMission() boolean\n        +startMission() boolean\n        +endMission(MissionState) void\n    }\n\n    class ResearchMission {\n        -Agent scientist\n        -Laboratory laboratory\n        -String experimentName\n        +ResearchMission(...)\n        +submitMission() boolean\n        +startMission() boolean\n        +endMission(MissionState) void\n    }\n\n    class RescueMission {\n        -Agent personnel\n        -Vehicle vehicle\n        -CommunicationStation communicationStation\n        +RescueMission(...)\n        +submitMission() boolean\n        +startMission() boolean\n        +endMission(MissionState) void\n    }\n\n    %% ==================== EMERGENCY PACKAGE ====================\n    class Emergency {\n        &lt;&lt;abstract&gt;&gt;\n        #String emergencyId\n        #String location\n        #String description\n        #Capability[] requiredCapabilities\n        #EmergencyState emergencyState\n        #String failureReason\n        #Emergency(String, String, Capability[])\n        +handle(Colony)* boolean\n    }\n\n    class OxygenLeak {\n        -Habitat affectedHabitat\n        -int leakAmount$\n        +OxygenLeak(Habitat)\n        +handle(Colony) boolean\n    }\n\n    class Fire {\n        -Laboratory affectedLaboratory\n        +Fire(Laboratory)\n        +handle(Colony) boolean\n    }\n\n    class RoverBreakdown {\n        -ExplorationRover damagedRover\n        -String breakdownLocation\n        +RoverBreakdown(ExplorationRover)\n        +handle(Colony) boolean\n    }\n\n    class MedicalEmergency {\n        -CrewMember patient\n        -Habitat medicalHabitat\n        +MedicalEmergency(CrewMember, Habitat)\n        +handle(Colony) boolean\n    }\n\n    %% ==================== COLONY PACKAGE ====================\n    class Colony {\n        -List~Agent~ agents\n        -List~Facility~ facilities\n        -Mission activeMission\n        -Environment environment\n        -int currentTime\n        -List~Emergency~ emergencyHistory\n        -List~Mission~ missionHistory\n        -Colony()\n        +setupColony()$ Colony\n        +addAgent(Agent) void\n        +addAgents(Agent...) void\n        +addFacility(Facility) void\n        +getTotalResource(ResourceType) int\n        +checkAvailableResources(ResourceType[], int) boolean\n        +deductResource(ResourceType, int) boolean\n        +checkAvailableEquipment(Equipment) boolean\n        +submitMission(Mission) boolean\n        +startActiveMission() boolean\n        +advanceTime(int) void\n        +triggerEmergency(Emergency) boolean\n        +generateStatusReport() String\n    }\n\n    %% ==================== INHERITANCE RELATIONSHIPS ====================\n    Agent &lt;|-- CrewMember\n    Agent &lt;|-- RoboticUnit\n    CrewMember &lt;|-- Engineer\n    CrewMember &lt;|-- MedicalOfficer\n    CrewMember &lt;|-- Scientist\n    RoboticUnit &lt;|-- RepairRobot\n    RoboticUnit &lt;|-- Vehicle\n    Vehicle &lt;|-- ExplorationRover\n    Vehicle &lt;|-- Drone\n\n    Facility &lt;|-- Habitat\n    Facility &lt;|-- Laboratory\n    Facility &lt;|-- PowerStation\n    Facility &lt;|-- StorageFacilities\n    Facility &lt;|-- CommunicationStation\n\n    Mission &lt;|-- ExplorationMission\n    Mission &lt;|-- RepairMission\n    Mission &lt;|-- ResearchMission\n    Mission &lt;|-- RescueMission\n\n    Emergency &lt;|-- OxygenLeak\n    Emergency &lt;|-- Fire\n    Emergency &lt;|-- RoverBreakdown\n    Emergency &lt;|-- MedicalEmergency\n\n    %% ==================== COMPOSITION RELATIONSHIPS ====================\n    Habitat \&quot;1\&quot; *-- \&quot;1\&quot; LifeSupportSystem : owns &gt;\n    Colony \&quot;1\&quot; *-- \&quot;1\&quot; Environment : manages &gt;\n\n    %% ==================== AGGREGATION RELATIONSHIPS ====================\n    Colony \&quot;1\&quot; o-- \&quot;0..*\&quot; Agent : manages &gt;\n    Colony \&quot;1\&quot; o-- \&quot;1..*\&quot; Facility : contains &gt;\n    Facility \&quot;1\&quot; o-- \&quot;0..*\&quot; Equipment : stores &gt;\n    ExplorationRover \&quot;1\&quot; o-- \&quot;0..*\&quot; Equipment : carries &gt;\n\n    %% ==================== ASSOCIATION RELATIONSHIPS ====================\n    Colony \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Mission : activeMission &gt;\n    Colony \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Mission : missionHistory &gt;\n    Colony \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Emergency : emergencyHistory &gt;\n    Mission \&quot;0..*\&quot; --&gt; \&quot;1..*\&quot; Agent : assigns &gt;\n    Mission \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; Equipment : uses &gt;\n    OxygenLeak --&gt; \&quot;1\&quot; Habitat : affects &gt;\n    Fire --&gt; \&quot;1\&quot; Laboratory : affects &gt;\n    RoverBreakdown --&gt; \&quot;1\&quot; ExplorationRover : damages &gt;\n    MedicalEmergency --&gt; \&quot;1\&quot; CrewMember : treats &gt;\n    MedicalEmergency --&gt; \&quot;1\&quot; Habitat : uses &gt;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="D4zLW4o0JVZk7E6yAUd3-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
