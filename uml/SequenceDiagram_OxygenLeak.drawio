  <diagram name="Page-1" id="xJe5HL-tUzzX3A5tEd4K">
    <mxGraphModel dx="7357" dy="3764" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Operator as Main / Operator\n    participant C as colony : Colony\n    participant E as leak : OxygenLeak\n    participant H as affectedHabitat : Habitat\n    participant Eng as humanRepairer : Engineer\n    participant Bot as robotRepairer : RepairRobot\n\n    Operator-&gt;&gt;C: triggerEmergency(leak)\n    activate C\n    C-&gt;&gt;C: emergencyHistory.add(leak)\n    C-&gt;&gt;E: handle(this)\n    activate E\n\n    E-&gt;&gt;E: setEmergencyState(TRIGGERED)\n    E-&gt;&gt;H: deductResource(OXYGEN, 50)\n    H--&gt;&gt;E: 50 deducted\n\n    E-&gt;&gt;C: getAgents()\n    loop Polymorphic Responder Search\n        E-&gt;&gt;Eng: isAvailable() &amp; !isOnMission() &amp; canHandle(EQUIPMENT_REPAIR) &amp; isHuman()\n        Eng--&gt;&gt;E: true\n        E-&gt;&gt;Bot: isAvailable() &amp; !isOnMission() &amp; canHandle(EQUIPMENT_REPAIR) &amp; isRobot()\n        Bot--&gt;&gt;E: true\n    end\n\n    alt Responders Available\n        E-&gt;&gt;C: getTotalResource(SPARE_PARTS) &gt;= 2 &amp; getTotalResource(BATTERY_POWER) &gt;= 5\n        C--&gt;&gt;E: resourcesSufficient\n\n        alt Resources Sufficient (Resolved Flow)\n            E-&gt;&gt;Eng: setLocation(affectedHabitat.getLocation())\n            E-&gt;&gt;Bot: setLocation(affectedHabitat.getLocation())\n            E-&gt;&gt;C: deductResource(SPARE_PARTS, 2)\n            E-&gt;&gt;C: deductResource(BATTERY_POWER, 5)\n            E-&gt;&gt;H: setOperationalStatus(true)\n            E-&gt;&gt;E: setEmergencyState(RESOLVED)\n            E--&gt;&gt;C: true\n        else Insufficient Resources (Unresolved Flow)\n            E-&gt;&gt;E: setEmergencyState(UNRESOLVED)\n            E-&gt;&gt;E: setFailureReason(\&quot;Insufficient response resources...\&quot;)\n            E-&gt;&gt;H: deductResource(OXYGEN, 50)\n            Note over E,H: Double oxygen loss penalty applied (100 total)\n            E--&gt;&gt;C: false\n        end\n    else Responders Unavailable (Unresolved Flow)\n        E-&gt;&gt;E: setEmergencyState(UNRESOLVED)\n        E-&gt;&gt;E: setFailureReason(\&quot;Required responders unavailable...\&quot;)\n        E-&gt;&gt;H: deductResource(OXYGEN, 50)\n        Note over E,H: Double oxygen loss penalty applied (100 total)\n        E--&gt;&gt;C: false\n    end\n\n    deactivate E\n    C--&gt;&gt;Operator: outcome (boolean)\n    deactivate C&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="l8SWZuApAEbl4fd_skBx-192">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
