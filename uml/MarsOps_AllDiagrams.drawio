          <mxGeometry x="1080" y="85" width="240" height="90" as="geometry" />
        </mxCell>
        <!-- mission object -->
        <mxCell id="miss_obj" value="&lt;u&gt;&lt;b&gt;expMission1 : ExplorationMission&lt;/b&gt;&lt;/u&gt;&lt;hr size=&quot;1&quot;/&gt;missionId = &quot;Mission-1&quot;&lt;br/&gt;description = &quot;Explore Gale Crater for water ice&quot;&lt;br/&gt;location = &quot;Gale Crater&quot;&lt;br/&gt;status = IN_PROGRESS&lt;br/&gt;requiredDuration = 7&lt;br/&gt;timeElapsed = 2&lt;br/&gt;requiredBatteryLevel = 25.0&lt;br/&gt;failureReason = &quot;&quot;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="610" y="270" width="340" height="170" as="geometry" />
        </mxCell>
        <!-- scientist object -->
        <mxCell id="watney_obj" value="&lt;u&gt;&lt;b&gt;watney : Scientist&lt;/b&gt;&lt;/u&gt;&lt;hr size=&quot;1&quot;/&gt;id = &quot;Scientist1&quot;&lt;br/&gt;name = &quot;Dr. Mark Watney&quot;&lt;br/&gt;location = &quot;Gale Crater&quot;&lt;br/&gt;healthStatus = 100&lt;br/&gt;fatigueLevel = 10&lt;br/&gt;onMission = true&lt;br/&gt;availability = false&lt;br/&gt;capabilities = [SCIENTIFIC_RESEARCH, ...]" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="280" height="170" as="geometry" />
        </mxCell>
        <!-- rover object -->
        <mxCell id="rover_obj" value="&lt;u&gt;&lt;b&gt;curiosity : ExplorationRover&lt;/b&gt;&lt;/u&gt;&lt;hr size=&quot;1&quot;/&gt;id = &quot;Rover1&quot;&lt;br/&gt;name = &quot;Curiosity-2&quot;&lt;br/&gt;location = &quot;Gale Crater&quot;&lt;br/&gt;healthStatus = 100&lt;br/&gt;batteryLevel = 90&lt;br/&gt;onMission = true&lt;br/&gt;availability = false&lt;br/&gt;capabilities = [SURFACE_EXPLORATION, ...]" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="520" width="280" height="170" as="geometry" />
        </mxCell>
        <!-- spectrometer object -->
        <mxCell id="spec_obj" value="&lt;u&gt;&lt;b&gt;spectrometer : Equipment&lt;/b&gt;&lt;/u&gt;&lt;hr size=&quot;1&quot;/&gt;name = &quot;Mass Spectrometer&quot;&lt;br/&gt;providedCapability = SCIENTIFIC_RESEARCH&lt;br/&gt;damaged = false&lt;br/&gt;available = false&lt;br/&gt;usageNumber = 1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="740" width="280" height="130" as="geometry" />
        </mxCell>
        <!-- habitat object -->
        <mxCell id="hab_obj" value="&lt;u&gt;&lt;b&gt;habitat1 : Habitat&lt;/b&gt;&lt;/u&gt;&lt;hr size=&quot;1&quot;/&gt;location = &quot;Habitat1&quot;&lt;br/&gt;capacity = 4&lt;br/&gt;currentOccupancy = 0&lt;br/&gt;isOperational = true&lt;br/&gt;maxResources = 300&lt;br/&gt;resources[OXYGEN] = 150&lt;br/&gt;resources[BATTERY] = 80&lt;br/&gt;resources[WATER] = 50" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="740" y="520" width="240" height="170" as="geometry" />
        </mxCell>
        <!-- lss object -->
        <mxCell id="lss_obj" value="&lt;u&gt;&lt;b&gt;lss1 : LifeSupportSystem&lt;/b&gt;&lt;/u&gt;&lt;hr size=&quot;1&quot;/&gt;filtrationRate = 90&lt;br/&gt;isFunctional = true&lt;br/&gt;ownedBy = habitat1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="740" y="740" width="240" height="90" as="geometry" />
        </mxCell>
        <!-- storage object -->
        <mxCell id="storage_obj" value="&lt;u&gt;&lt;b&gt;storage1 : StorageFacilities&lt;/b&gt;&lt;/u&gt;&lt;hr size=&quot;1&quot;/&gt;location = &quot;Storage Facility1&quot;&lt;br/&gt;isOperational = true&lt;br/&gt;resources[OXYGEN] = 200&lt;br/&gt;resources[SPARE_PARTS] = 80&lt;br/&gt;resources[WATER] = 150&lt;br/&gt;resources[BATTERY] = 200" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1050" y="520" width="250" height="150" as="geometry" />
        </mxCell>
        <!-- Links -->
        <mxCell id="l_env" value="environment" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="colony_obj" target="env_obj" parent="1" />
        <mxCell id="l_miss" value="activeMission" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#334155;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="colony_obj" target="miss_obj" parent="1" />
        <mxCell id="l_watney" value="assigned crewMember" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#334155;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" source="miss_obj" target="watney_obj" parent="1" />
        <mxCell id="l_rover" value="assigned vehicle" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#334155;exitX=0.4;exitY=1;entryX=0.5;entryY=0;" edge="1" source="miss_obj" target="rover_obj" parent="1" />
        <mxCell id="l_spec" value="carriedEquipment" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#334155;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="rover_obj" target="spec_obj" parent="1" />
        <mxCell id="l_hab" value="facilities[0]" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#334155;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" source="colony_obj" target="hab_obj" parent="1" />
        <mxCell id="l_lss" value="lifeSupport (owned)" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#334155;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="hab_obj" target="lss_obj" parent="1" />
        <mxCell id="l_storage" value="facilities[4]" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#334155;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" source="colony_obj" target="storage_obj" parent="1" />
        <mxCell id="l_colony_watney" value="agents[0]" style="endArrow=none;html=1;strokeWidth=1.8;strokeColor=#334155;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" source="colony_obj" target="watney_obj" parent="1" />
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="StateMachineDiagram" name="3. State Machine Diagram">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;MARS-OPS SYSTEM — MISSION LIFECYCLE STATE MACHINE DIAGRAM&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>

        <!-- Initial Pseudostate -->
        <mxCell id="init" value="" style="ellipse;fillColor=#0f172a;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lbl_init" value="Mission Created" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="235" width="110" height="20" as="geometry" />
        </mxCell>

        <!-- ASSIGNED State -->
        <mxCell id="s_assigned" value="&lt;b&gt;ASSIGNED&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;entry / colony.setActive(this)&lt;br/&gt;do / wait for execution trigger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="380" y="170" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- IN_PROGRESS State -->
        <mxCell id="s_inprogress" value="&lt;b&gt;IN_PROGRESS&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;entry / status = IN_PROGRESS&lt;br/&gt;do / colony.advanceTime progresses duration&lt;br/&gt;exit / unassign agents, release equipment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="160" width="280" height="110" as="geometry" />
        </mxCell>

        <!-- COMPLETED State -->
        <mxCell id="s_completed" value="&lt;b&gt;COMPLETED&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;entry / unassign agents&lt;br/&gt;entry / release equipment &amp;amp; target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1240" y="170" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- Final State for COMPLETED -->
        <mxCell id="final_comp" value="" style="ellipse;shape=doubleEllipse;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="1340" y="320" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- FAILED State -->
        <mxCell id="s_failed" value="&lt;b&gt;FAILED&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;entry / status = FAILED&lt;br/&gt;entry / colony.removeActiveMission()&lt;br/&gt;entry / unassign agents &amp;amp; release equip&lt;br/&gt;note: non-retriable, immutable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="520" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- Final State for FAILED -->
        <mxCell id="final_fail" value="" style="ellipse;shape=doubleEllipse;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="905" y="700" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Normal Transitions -->
        <!-- init -> ASSIGNED -->
        <mxCell id="t1" value="colony.submitMission(m)&lt;br/&gt;[Requirements Met: agents capable &amp;amp;&amp;amp;&lt;br/&gt;resources available &amp;amp;&amp;amp; no other active mission]" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="init" target="s_assigned" parent="1" />
        
        <!-- ASSIGNED -> IN_PROGRESS -->
        <mxCell id="t2" value="mission.startMission()&lt;br/&gt;/ assign agents, mark busy,&lt;br/&gt;consume resources, timeElapsed=0" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="s_assigned" target="s_inprogress" parent="1" />

        <!-- IN_PROGRESS self-transition -->
        <mxCell id="t_loop" value="colony.advanceTime(t)&lt;br/&gt;[timeElapsed + t &amp;lt; duration &amp;amp;&amp;amp; no disruption]&lt;br/&gt;/ timeElapsed += t, battery -= x, fatigue += y" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#334155;exitX=0.3;exitY=0;entryX=0.7;entryY=0;" edge="1" source="s_inprogress" target="s_inprogress" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="864" y="90" />
              <mxPoint x="976" y="90" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- IN_PROGRESS -> COMPLETED -->
        <mxCell id="t3" value="colony.advanceTime(t)&lt;br/&gt;[timeElapsed &amp;gt;= requiredDuration]&lt;br/&gt;/ mission.endMission(COMPLETED)" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#16a34a;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="s_inprogress" target="s_completed" parent="1" />

        <!-- COMPLETED -> final -->
        <mxCell id="t_comp_final" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#334155;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="s_completed" target="final_comp" parent="1" />

        <!-- Failure Transitions -->
        <!-- 1. Immediate Rejection: init -> FAILED -->
        <mxCell id="t_rej" value="[REJECTION] colony.submitMission(m)&lt;br/&gt;[Guard: Another mission active || Agent lacks capability ||&lt;br/&gt;Insufficient resources || Dust storm on exploration]&lt;br/&gt;/ status = FAILED, record reason; NEVER BECOMES ACTIVE" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#dc2626;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" source="init" target="s_failed" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="95" y="580" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 2. Dynamic Runtime Failure: IN_PROGRESS -> FAILED -->
        <mxCell id="t_fail_dyn" value="[RUNTIME FAILURE] colony.advanceTime(t)&lt;br/&gt;[Guard: Dust storm strikes rover || Comm disruption during drone ||&lt;br/&gt;Equipment damaged || Battery depleted]&lt;br/&gt;/ mission.fail(reason), unassign agents, release equipment" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#dc2626;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="s_inprogress" target="s_failed" parent="1" />

        <!-- FAILED -> final -->
        <mxCell id="t_fail_final" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#334155;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="s_failed" target="final_fail" parent="1" />

        <!-- Notes Box -->
        <mxCell id="box_notes" value="&lt;b&gt;Lab 5 State Machine Specification Compliance Rules:&lt;/b&gt;&lt;br/&gt;1. Lifecycle States: ASSIGNED, IN_PROGRESS, COMPLETED, FAILED are strictly represented.&lt;br/&gt;2. Immediate Rejection Rule: An invalid or rejected mission transitions immediately to FAILED and NEVER enters ASSIGNED or IN_PROGRESS.&lt;br/&gt;3. Terminal State Rule: Failed and Completed missions cannot be retried; a new mission instance must be created for another attempt." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1500" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="SeqMission" name="4A. Sequence - Mission">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;SEQUENCE DIAGRAM 4A: MISSION SUBMISSION AND EXECUTION&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll_op" value=":ColonyOperator" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dbeafe;strokeColor=#1e40af;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="130" height="850" as="geometry" />
        </mxCell>
        <mxCell id="ll_colony" value="colony:Colony" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f1f5f9;strokeColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="130" height="850" as="geometry" />
        </mxCell>
        <mxCell id="ll_mission" value="m:ExplorationMission" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f1f5f9;strokeColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="160" height="850" as="geometry" />
        </mxCell>
        <mxCell id="ll_sci" value="s:Scientist" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f1f5f9;strokeColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="80" width="130" height="850" as="geometry" />
        </mxCell>
        <mxCell id="ll_rover" value="r:ExplorationRover" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f1f5f9;strokeColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="80" width="150" height="850" as="geometry" />
        </mxCell>

        <!-- Messages -->
        <!-- 1: submitMission -->
        <mxCell id="m1" value="1: submitMission(m)" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#1e293b;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="125" y="160" as="sourcePoint" />
            <mxPoint x="385" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2: check activeMission == null -->
        <mxCell id="m2" value="2: check activeMission == null" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#1e293b;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="385" y="180" as="sourcePoint" />
            <mxPoint x="395" y="200" as="targetPoint" />
            <Array as="points">
              <mxPoint x="430" y="180" />
              <mxPoint x="430" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 3: m.submitMission() -->
        <mxCell id="m3" value="3: submitMission()" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#1e293b;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="385" y="220" as="sourcePoint" />
            <mxPoint x="700" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4: canPerform(m) on scientist -->
        <mxCell id="m4" value="4: canPerform(m)" style="endArrow=block;html=1;strokeWidth=1.8;strokeColor=#1e293b;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="700" y="245" as="sourcePoint" />
            <mxPoint x="985" y="245" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5: return true (SCIENTIFIC_RESEARCH present)" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#1e293b;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="985" y="270" as="sourcePoint" />
            <mxPoint x="700" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 6: canPerform(m) & battery on rover -->
        <mxCell id="m6" value="6: canPerform(m) &amp;amp; getBatteryLevel()" style="endArrow=block;html=1;strokeWidth=1.8;strokeColor=#1e293b;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="700" y="295" as="sourcePoint" />
            <mxPoint x="1255" y="295" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7: return true &amp;amp; 100% (&amp;gt;= 25%)" style="endArrow=open;dashed=1;html=1;strokeWidth=1.5;strokeColor=#1e293b;" edge="1" parent="1">
