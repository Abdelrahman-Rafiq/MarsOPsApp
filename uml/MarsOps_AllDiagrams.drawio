        <!-- EmergencyState -->
        <mxCell id="EmergencyState" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;&lt;b&gt;EmergencyState&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;TRIGGERED&lt;br/&gt;RESOLVED&lt;br/&gt;UNRESOLVED&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=10.5;fontFamily=Helvetica;html=1;rounded=0;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="580" y="1300" width="140" height="110" as="geometry" />
        </mxCell>

        <!-- EnvironmentCondition -->
        <mxCell id="EnvironmentCondition" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;&lt;b&gt;EnvironmentCondition&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;NORMAL&lt;br/&gt;DUST_STORM&lt;br/&gt;COMMUNICATION_DISRUPTION&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=10.5;fontFamily=Helvetica;html=1;rounded=0;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="740" y="1300" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- ==================== 7. UML RELATIONSHIP LEGEND ==================== -->
        <mxCell id="Legend" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;UML Relationship Legend &amp;amp; Object-Oriented Design Justification (Lab 5 Sections 11.1 &amp;amp; 11.2)&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:4px;&quot;&gt;&lt;b&gt;1. Association (Solid line / open arrow):&lt;/b&gt; Objects interact or collaborate without lifecycle dependence (e.g., Mission references assignedAgents; Colony references activeMission; Vehicle mounts Equipment).&lt;br/&gt;&lt;b&gt;2. Aggregation (Hollow diamond):&lt;/b&gt; Whole-part relationship where parts survive whole&apos;s lifecycle (e.g., Colony aggregates Agents &amp;amp; Facilities; if Colony shuts down, members exist).&lt;br/&gt;&lt;b&gt;3. Composition (Solid diamond):&lt;/b&gt; Strong ownership; part&apos;s lifecycle is strictly tied to the whole (e.g., Habitat owns LifeSupportSystem; destroying Habitat destroys its LSS).&lt;br/&gt;&lt;b&gt;4. Generalization / Inheritance (Hollow triangle):&lt;/b&gt; &apos;is-a&apos; polymorphic hierarchies (Agent -&amp;gt; CrewMember -&amp;gt; Scientist; Facility -&amp;gt; Habitat; Mission -&amp;gt; Exploration; Emergency -&amp;gt; OxygenLeak).&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1290" width="1240" height="190" as="geometry" />
        </mxCell>

        <!-- ==================== 8. CONNECTORS ==================== -->

        <!-- Aggregation: Colony to Agent (0..*) -->
        <mxCell id="rel_colony_agent" value="aggregates&lt;br/&gt;0..*" style="endArrow=diamond;html=1;endFill=0;strokeWidth=2;strokeColor=#334155;exitX=0;exitY=0.7;entryX=0.5;entryY=0;" edge="1" source="Colony" target="Agent" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Aggregation: Colony to Facility (0..*) -->
        <mxCell id="rel_colony_facility" value="aggregates&lt;br/&gt;0..*" style="endArrow=diamond;html=1;endFill=0;strokeWidth=2;strokeColor=#334155;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" source="Colony" target="Facility" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Association: Colony to Mission (0..1 active) -->
        <mxCell id="rel_colony_mission" value="0..1 activeMission" style="endArrow=open;html=1;endFill=0;strokeWidth=2;strokeColor=#334155;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" source="Colony" target="Mission" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Aggregation: Colony to Emergency (0..* history) -->
        <mxCell id="rel_colony_emergency" value="0..* history" style="endArrow=diamond;html=1;endFill=0;strokeWidth=2;strokeColor=#334155;exitX=1;exitY=0.7;entryX=0.5;entryY=0;" edge="1" source="Colony" target="Emergency" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Association: Colony to Environment -->
        <mxCell id="rel_colony_env" value="environment" style="endArrow=open;html=1;endFill=0;strokeWidth=2;strokeColor=#334155;exitX=1;exitY=0.2;entryX=0;entryY=0.2;" edge="1" source="Colony" target="Environment" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Composition: Habitat owns LifeSupportSystem -->
        <mxCell id="rel_hab_lss" value="1 owns 1" style="endArrow=diamond;html=1;endFill=1;strokeWidth=2;strokeColor=#0f172a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="Habitat" target="LifeSupportSystem" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Association: Mission to Agent (assignedAgents 1..*) -->
        <mxCell id="rel_miss_agent" value="assignedAgents 1..*" style="endArrow=open;html=1;endFill=0;strokeWidth=2;strokeColor=#334155;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="Mission" target="Agent" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Association: Mission to Equipment -->
        <mxCell id="rel_miss_equip" value="equipment" style="endArrow=open;html=1;endFill=0;strokeWidth=2;strokeColor=#334155;exitX=0.8;exitY=0;entryX=0.2;entryY=1;" edge="1" source="Mission" target="Equipment" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Association: Vehicle to Equipment (carriedEquipment) -->
        <mxCell id="rel_veh_equip" value="carriedEquipment" style="endArrow=open;html=1;endFill=0;strokeWidth=2;strokeColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" source="Vehicle" target="Equipment" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Inheritance: CrewMember -> Agent -->
        <mxCell id="inh_crew_agent" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" source="CrewMember" target="Agent" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Inheritance: RoboticUnit -> Agent -->
        <mxCell id="inh_robot_agent" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="RoboticUnit" target="Agent" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Inheritance: Scientist, Engineer, MedicalOfficer -> CrewMember -->
        <mxCell id="inh_sci_crew" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" source="Scientist" target="CrewMember" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_eng_crew" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="Engineer" target="CrewMember" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_med_crew" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="MedicalOfficer" target="CrewMember" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Inheritance: RepairRobot, Vehicle -> RoboticUnit -->
        <mxCell id="inh_repbot_robot" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" source="RepairRobot" target="RoboticUnit" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_veh_robot" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="Vehicle" target="RoboticUnit" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Inheritance: ExplorationRover, Drone -> Vehicle -->
        <mxCell id="inh_rover_veh" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" source="ExplorationRover" target="Vehicle" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_drone_veh" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="Drone" target="Vehicle" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Inheritance: Habitat, Laboratory, PowerStation, StorageFacilities, CommunicationStation -> Facility -->
        <mxCell id="inh_hab_fac" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" source="Habitat" target="Facility" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_lab_fac" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="Laboratory" target="Facility" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_power_fac" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="PowerStation" target="Facility" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_storage_fac" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" source="StorageFacilities" target="Facility" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_comm_fac" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="CommunicationStation" target="Facility" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Inheritance: ExplorationMission, RepairMission, ResearchMission, RescueMission -> Mission -->
        <mxCell id="inh_exp_miss" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" source="ExplorationMission" target="Mission" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_rep_miss" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="RepairMission" target="Mission" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_res_miss" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" source="ResearchMission" target="Mission" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_resc_miss" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="RescueMission" target="Mission" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Inheritance: OxygenLeak, Fire, RoverBreakdown, MedicalEmergency -> Emergency -->
        <mxCell id="inh_leak_emg" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" source="OxygenLeak" target="Emergency" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_fire_emg" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="Fire" target="Emergency" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_rb_emg" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.3;entryY=1;" edge="1" source="RoverBreakdown" target="Emergency" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inh_med_emg" style="endArrow=block;html=1;endFill=0;strokeWidth=2;strokeColor=#1e3a8a;exitX=0.5;exitY=0;entryX=0.7;entryY=1;" edge="1" source="MedicalEmergency" target="Emergency" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ObjectDiagram" name="2. Object Diagram">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;MARS-OPS SYSTEM — OBJECT DIAGRAM (SNAPSHOT AT TIME = 2)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;fontColor=#ffffff;strokeColor=#0f172a;" vertex="1" parent="1">
