        <!-- Fire -->
        <mxCell id="Fire" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Fire&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- lab: Laboratory&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ Fire(lab: Laboratory)&lt;br/&gt;+ handle(colony: Colony): boolean&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;rounded=0;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1950" y="700" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- RoverBreakdown -->
        <mxCell id="RoverBreakdown" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;RoverBreakdown&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- damagedRover: ExplorationRover&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ RoverBreakdown(r: ExplorationRover)&lt;br/&gt;+ handle(colony: Colony): boolean&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;rounded=0;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1700" y="830" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- MedicalEmergency -->
        <mxCell id="MedicalEmergency" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;MedicalEmergency&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- patient: CrewMember&lt;br/&gt;- medicalHabitat: Habitat&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ MedicalEmergency(p, hab)&lt;br/&gt;+ handle(colony: Colony): boolean&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;rounded=0;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1950" y="830" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- ==================== 6. ENUMS ==================== -->

        <!-- Capability -->
        <mxCell id="Capability" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;&lt;b&gt;Capability&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;SCIENTIFIC_RESEARCH&lt;br/&gt;EQUIPMENT_REPAIR&lt;br/&gt;MEDICAL_CARE&lt;br/&gt;SURFACE_EXPLORATION&lt;br/&gt;AERIAL_RECON&lt;br/&gt;COMMUNICATION&lt;br/&gt;FIRE_RESPONSE&lt;br/&gt;RESCUE&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=10.5;fontFamily=Helvetica;html=1;rounded=0;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="40" y="1300" width="180" height="180" as="geometry" />
        </mxCell>

        <!-- ResourceType -->
        <mxCell id="ResourceType" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;&lt;b&gt;ResourceType&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;OXYGEN&lt;br/&gt;WATER&lt;br/&gt;FOOD&lt;br/&gt;FUEL&lt;br/&gt;BATTERY_POWER&lt;br/&gt;MEDICAL_SUPPLIES&lt;br/&gt;SPARE_PARTS&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=10.5;fontFamily=Helvetica;html=1;rounded=0;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="240" y="1300" width="160" height="170" as="geometry" />
        </mxCell>

        <!-- MissionState -->
        <mxCell id="MissionState" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&amp;laquo;enumeration&amp;raquo;&lt;br/&gt;&lt;b&gt;MissionState&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;ASSIGNED&lt;br/&gt;IN_PROGRESS&lt;br/&gt;COMPLETED&lt;br/&gt;FAILED&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=10.5;fontFamily=Helvetica;html=1;rounded=0;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#ca8a04;" vertex="1" parent="1">
          <mxGeometry x="420" y="1300" width="140" height="120" as="geometry" />
